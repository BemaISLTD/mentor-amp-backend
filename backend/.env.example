# Neon direct connection (for Alembic migrations — NO "-pooler" in hostname)
DATABASE_URL=postgresql+psycopg2://user:password@ep-xxxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# App settings
APP_NAME=MentorAmp
# Where this process runs: local | test | development | staging | production.
# Demo mode (AUTH_MODE=disabled) is refused unless APP_ENV is local or test.
# staging/production also require an explicit CORS_ORIGINS list.
APP_ENV=local
DEBUG=true

# Authentication (replace with a long random value outside local development)
JWT_SECRET_KEY=development-only-change-me-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Milestone 1 ---
# Demo mode: "disabled" runs every request as the demo admin (no login). Only allowed with
# APP_ENV=local or test AND DEBUG=true. The demo admin is created by scripts/seed_demo.py.
AUTH_MODE=jwt
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8001
# Log every SQL statement (very noisy; debugging only).
SQL_ECHO=false
# Build identity frozen into every run package; a worker refuses packages frozen under another build.
# CODE_VERSION: release label. SOURCE_COMMIT: git commit SHA. BUILD_FINGERPRINT: immutable hash of
# the built artifact (e.g. sha256 of the image/wheel). staging/production MUST set SOURCE_COMMIT and
# BUILD_FINGERPRINT (startup is refused otherwise). Locally they may stay empty: the fingerprint is
# then computed from the loaded source files, so uncommitted edits change it.
CODE_VERSION=development
SOURCE_COMMIT=
BUILD_FINGERPRINT=
