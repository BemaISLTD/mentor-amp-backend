# Neon direct connection (for Alembic migrations — NO "-pooler" in hostname)
DATABASE_URL=postgresql+psycopg2://user:password@ep-xxxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# App settings
APP_NAME=MentorAmp
DEBUG=true

# Authentication (replace with a long random value outside local development)
JWT_SECRET_KEY=development-only-change-me-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Milestone 1 ---
# Demo mode: "disabled" runs every request as the demo admin (no login). Only allowed with DEBUG=true.
AUTH_MODE=jwt
# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8001
# Log every SQL statement (very noisy; debugging only).
SQL_ECHO=false
# Recorded in run manifests; set to the git commit in CI or deployments.
CODE_VERSION=development
